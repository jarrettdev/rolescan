{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "job-scraper-kit filters",
 "type": "object",
 "required": [
  "note",
  "base",
  "locations",
  "filters"
 ],
 "additionalProperties": false,
 "properties": {
  "note": {
   "type": "string"
  },
  "base": {
   "type": "object"
  },
  "locations": {
   "type": "object",
   "additionalProperties": {
    "type": "array"
   }
  },
  "filters": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "location",
     "overrides"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "location": {
      "type": "string"
     },
     "overrides": {
      "type": "object"
     }
    }
   }
  },
  "blocked_companies": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "title_exclude": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}
