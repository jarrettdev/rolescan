# Copy to .env (setup.sh does this once) and fill only what you use.
# Nothing here is required for the fixture run.

# print | webhook | discord
NOTIFY=print

# NOTIFY=discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# A DM is a second, explicit opt-in; a channel post is the default.
ENABLE_DM=0
DM_USER_ID=

# NOTIFY=webhook
NOTIFY_WEBHOOK_URL=

# Sources
ENABLE_HIRING_CAFE=1
HC_SOLVE_CAPTCHA=0
ENRICH=0
# Optional page fetcher for company links: any executable taking a URL on argv.
JOBKIT_FETCH=

# State, filters and config path (blank means the defaults: ./data, filters/active.json, ./.env)
JOBKIT_DATA=
JOBKIT_FILTERS=
JOBKIT_ENV=
