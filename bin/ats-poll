#!/usr/bin/env python3
"""Poll the employer boards in the ATS registry and hand new postings to the
one-shot ingest (ADR 0015).

    bin/ats-poll [--dry-run]

Writes at most one job_listings_<ms>.csv per run into <JOBKIT_DATA>/drop, in the
scrape CSV format, so `process_stream.py` and the ledger handle it unchanged.
Selection is the pure goal select-ats-postings. A posting is marked emitted in
the registry only after its CSV is written. --dry-run fetches and selects but
writes nothing. Company enrichment is off unless ENRICH=1.
"""

import os
import sys
from pathlib import Path as _Path

_VENV = _Path(__file__).resolve().parents[1] / "venv" / "bin" / "python"
if __name__ == "__main__" and _VENV.exists() and _Path(sys.executable) != _VENV:
    os.execv(str(_VENV), [str(_VENV), str(_Path(__file__).resolve()), *sys.argv[1:]])

import argparse
import csv
import fcntl
import importlib.util
import os
import subprocess
import sys
import time
import traceback
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "values"))
sys.path.insert(0, str(ROOT / "domain" / "ats_registry"))
sys.path.insert(0, str(ROOT / "domain" / "ledger"))
from adapters import ats as A  # noqa: E402
from adapters import config, paths  # noqa: E402

CRON_HOURS = (0, 4, 8, 12, 16, 20)  # the hiring.cafe scrape hours the poller stands aside for
from ats_registry import AtsRegistry  # noqa: E402
import lanes as L  # noqa: E402
from posting_key import posting_key  # noqa: E402
from scrape_csv import SCRAPE_COLUMNS, row_to_csv  # noqa: E402

WINDOW_BEFORE = timedelta(minutes=25)
WINDOW_AFTER = timedelta(minutes=15)
MAX_DETAILS = 40  # detail requests per run for ATSs whose lists carry no description
ENRICH_DEADLINE_S = 760  # no company lookup starts later in a run: a cache miss can take 65 s, cron runs every 900 s


def _load_goal(name, mod):
    spec = importlib.util.spec_from_file_location(mod, ROOT / "goals" / name / "implementation.py")
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


SELECT = _load_goal("select-ats-postings", "select_ats_postings_goal")


def blocked_companies():
    """Blocked companies from the user's filters document (adrs/0019)."""
    import json as _json
    try:
        doc = _json.loads(paths.filters_path().read_text())
    except (OSError, ValueError):
        doc = {}
    return L.blocked_companies(doc)


def in_cron_window(now):
    for day in (-1, 0, 1):
        base = (now + timedelta(days=day)).replace(minute=0, second=0, microsecond=0)
        for h in CRON_HOURS:
            t = base.replace(hour=h)
            if t - WINDOW_BEFORE <= now <= t + WINDOW_AFTER:
                return True
    return False


def _known_keys(root, registry):
    from ledger import Ledger
    path = root / "processed_jobs.csv"
    keys = set(Ledger(path).keys()) if path.exists() else set()
    return keys | set(registry.emitted_keys())


def fetch_all(client, boards):
    """Every board's postings, one worker per API host. Returns (postings, failed boards)."""
    by_host = defaultdict(list)
    for b in boards:
        host = b.get("host") if b["ats"] == "workday" else urlsplit(A.BASES[b["ats"]]).hostname
        by_host[host].append(b)
    postings, failed = [], []

    def work(bs):
        out, bad = [], []
        for b in bs:
            got = A.list_board(client, b)
            if got is None:
                bad.append(f"{b['ats']}:{b['tenant']}")
            else:
                out.extend(dict(p, _board=b) for p in got)
        return out, bad

    with ThreadPoolExecutor(max_workers=max(1, min(8, len(by_host)))) as pool:
        for out, bad in pool.map(work, by_host.values()):
            postings += out
            failed += bad
    return postings, failed


def learn_hosts(registry, postings):
    """Map custom domains to Greenhouse boards from the boards' own job lists:
    a job on a registered board whose absolute_url is on another host shows
    that host fronts the board (the list answered 200, so it is verified)."""
    known, added = registry.hosts(), 0
    for p in postings:
        if p.get("ats") != "greenhouse":
            continue
        host = (urlsplit(p.get("url") or "").hostname or "").lower()
        if host and not host.endswith("greenhouse.io") and host not in known:
            added += registry.add_host(host, p["tenant"], verified_status=200, source="board list")
            known = registry.hosts()
    return added


def default_enrich(rows):
    import linkedin_lookup  # its VPN fetch and cache are needed only here
    return linkedin_lookup.enrich(rows)


def add_company_links(rows, started, enrich, clock, log=print):
    """company_linkedin for each row through enrich (one row at a time) until
    ENRICH_DEADLINE_S after started; later rows, and rows whose lookup raised,
    keep their homepage. Returns how many rows went through enrich."""
    done = 0
    for row in rows:
        homepage = row.get("company_homepage", "")
        if enrich is not None and clock() - started < ENRICH_DEADLINE_S:
            try:
                enrich([row])
                done += 1
            except Exception as e:
                log(f"  [warn] company link lookup failed for {row.get('company')}: {e}")
        if "company_homepage" in row:
            row["company_linkedin"] = row.get("company_linkedin") or homepage
            del row["company_homepage"]
    return done


def write_csv(rows, out_dir, now):
    """One scrape CSV, written under a name the watcher ignores and then
    renamed into place, so process_stream never reads half a file."""
    name = f"job_listings_{int(now.timestamp() * 1000)}.csv"
    tmp = Path(out_dir) / f".{name}.tmp"
    with open(tmp, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(SCRAPE_COLUMNS)
        for row in rows:
            w.writerow(row_to_csv(row))
    final = Path(out_dir) / name
    os.replace(tmp, final)
    return final


def run(root=ROOT, out_dir=None, client=None, now=None, dry_run=False, running=None, log=print,
        enrich=None, clock=time.monotonic):
    """One poll. Returns the summary dict; raises only on a programming error.
    A dry run looks nothing up, so its rows carry the homepage only."""
    t0 = clock()
    now = now or datetime.now(timezone.utc)
    if out_dir is None:
        out_dir = paths.data_root() / "drop"
        Path(out_dir).mkdir(parents=True, exist_ok=True)
    registry = AtsRegistry(root / "ats_registry.jsonl")
    client = client or A.Client(cache_dir=root / ".cache" / "ats")
    lanes = L.load()
    known = _known_keys(root, registry)
    day = now.replace(hour=0, minute=0, second=0, microsecond=0).isoformat()
    emitted_today = registry.emitted_since(day)
    blocked = blocked_companies()
    postings, failed = fetch_all(client, registry.boards())
    hosts_learned = 0 if dry_run else learn_hosts(registry, postings)
    pre = SELECT.prefilter(postings, lanes, known, now, blocked)
    details = 0
    for p in pre:
        if p["ats"] in ("smartrecruiters", "workday") and not p.get("text"):
            if details >= MAX_DETAILS:
                break
            details += 1
            A.fill_detail(client, p["_board"], p)
    picked = SELECT.select_ats_postings(pre, lanes, known, emitted_today, now, blocked)
    rows = [row for row, _, _ in picked]
    enrich_fn = None if dry_run else enrich
    if enrich_fn is None and not dry_run and config.enrichment_enabled():
        enrich_fn = default_enrich
    enriched = add_company_links(rows, t0, enrich_fn, clock, log)
    written = None
    if picked and not dry_run:
        written = write_csv(rows, out_dir, now)
        for _, p, lane in picked:
            registry.mark_emitted(p["ats"], p["tenant"], p["job_id"], key=posting_key(p["url"]),
                                  detected_at=now.isoformat(timespec="seconds"),
                                  first_published=p.get("first_published"), lane=lane)
    s = client.stats
    summary = dict(boards=len(registry.boards()), failed=len(failed), postings=len(postings), hosts_learned=hosts_learned,
                   prefiltered=len(pre),
                   details=details, rows=len(picked), enriched=enriched, emitted_today=emitted_today + (len(picked) if written else 0),
                   requests=s["requests"], ok=s["ok"], not_modified=s["not_modified"], http_failed=s["failed"],
                   skipped=s["skipped"], elapsed=round(clock() - t0), csv=str(written) if written else "")
    line = "ATS_POLL: " + " ".join(f"{k}={v}" for k, v in summary.items())
    log(line + (" dry_run=1" if dry_run else ""))
    if not dry_run:  # bin/edge-report reads the run history from here
        with open(root / "ats_poll.log", "a") as f:
            f.write(f"{now.isoformat(timespec='seconds')} {line}\n")
    for _, p, lane in picked:
        log(f"  {'would emit' if dry_run else 'emitted'}: {p['title']} | {p['company']} | {lane} | {p['url']}")
    return summary


def main(argv=None, root=None, out_dir=None, client=None, now=None, running=None, log=print):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args(argv)
    root = Path(root) if root else paths.data_root()
    out_dir = Path(out_dir) if out_dir else (root / "drop")
    fd = os.open(root / "ats_poll.lock", os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("ATS_POLL: already running")
        os.close(fd)
        return 0
    stamp = root / "ats_poll.stamp"
    try:
        now = now or datetime.now(timezone.utc)
        run(root, out_dir, client, now, a.dry_run, running, log)
        if not a.dry_run:
            stamp.touch()
        return 0
    except Exception:
        traceback.print_exc()
        return 1
    finally:
        os.close(fd)


if __name__ == "__main__":
    sys.exit(main())
