#!/usr/bin/env python3
"""Build the ATS board registry from the posting URLs this box has seen
(adrs/0015).

    bin/ats-registry build [--limit N] [--budget SECONDS]
    bin/ats-registry show

build: candidates come from the ledger, the jobs_*.json archive and
ats_candidates/*.txt (raw hiring.cafe hits written by hc_scraper), through the
pure goal build-ats-registry. Each new board is verified against its public
API and added only on a 200; each Greenhouse custom domain is mapped to its
board only when the embed redirect names a board whose API job shows that
domain. Prints one summary line. A second build while one runs exits 2.
"""
import argparse
import fcntl
import glob
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "domain" / "ats_registry"))
sys.path.insert(0, str(ROOT / "domain" / "ledger"))
from adapters import ats as A  # noqa: E402
from adapters import paths  # noqa: E402
from ats_registry import AtsRegistry  # noqa: E402

LOCK = paths.data_root() / "ats_registry.lock"
CANDIDATES = paths.data_root() / "ats_candidates"


def _goal():
    spec = importlib.util.spec_from_file_location("build_ats_registry_goal", ROOT / "goals" / "build-ats-registry" / "implementation.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def seen_urls(root=None):
    """Posting URLs from the ledger (read view), the archive and the candidate
    files, and the listing company for each URL that has one."""
    from ledger import Ledger
    root = Path(root) if root else paths.data_root()
    urls, companies = [], {}
    ledger_path = root / "processed_jobs.csv"
    if ledger_path.exists():
        led = Ledger(ledger_path)
        for k in led.keys():
            row = led.get(k) or {}
            url = str(row.get("Scraped URL") or "")
            urls.append(url)
            companies.setdefault(url, str(row.get("Company") or ""))
    for f in sorted(glob.glob(str(root / "jobs_*.json"))):
        try:
            rows = json.loads(Path(f).read_text())
        except (OSError, ValueError):
            continue
        for r in rows:
            if isinstance(r, dict):
                urls.append(r.get("apply_url") or "")
                companies.setdefault(r.get("apply_url") or "", str(r.get("company") or ""))
    for f in sorted(glob.glob(str(root / "ats_candidates" / "*.txt"))):
        try:
            urls += Path(f).read_text().split()
        except OSError:
            continue
    return urls, companies


def _host_on_board(client, token, host):
    """True when the board's own job list shows a job on this host."""
    from urllib.parse import urlsplit
    postings = A.list_board(client, {"ats": "greenhouse", "tenant": token}) or []
    return any((urlsplit(p["url"]).hostname or "").lower() == host for p in postings)


def build(registry, client, urls, limit=None, log=print, companies=None):
    goal = _goal()
    cands = goal.build_ats_registry(urls, companies)
    known = {(b["ats"], b["tenant"]) for b in registry.boards()}
    todo = [e for k, e in cands["boards"].items() if k not in known]
    hosts = [(h, s) for h, s in cands["gh_hosts"].items() if h not in registry.hosts()]
    if limit is not None:
        todo, hosts = todo[:limit], hosts[:limit]
    added, failed, hosts_added, hosts_failed = 0, [], 0, []
    for e in todo:
        status = A.verify_board(client, e)
        if status == 200:
            added += registry.add_board(e["ats"], e["tenant"], verified_status=200, site=e.get("site"),
                                        host=e.get("host"), source=e["sample_url"])
        else:
            failed.append(f"{e['ats']}:{e['tenant']} {status}")
    guessed = 0
    for host, samples in hosts:
        token = A.resolve_host(client, host, samples)
        names = cands["host_companies"].get(host, [])
        if not token and names:
            # the embed redirect failed (its sample postings may have closed):
            # try boards named after the company, and accept one only when its
            # own job list shows jobs on this host. A host that fronts several
            # employers is never mapped; their boards are still registered.
            known_now = {(b["ats"], b["tenant"]) for b in registry.boards()}
            for name in names:
                for guess in goal.board_guesses(host, name):
                    if ("greenhouse", guess) not in known_now and A.verify_board(client, {"ats": "greenhouse", "tenant": guess}) != 200:
                        continue
                    if not _host_on_board(client, guess, host):
                        continue
                    if ("greenhouse", guess) not in known_now:
                        added += registry.add_board("greenhouse", guess, verified_status=200, source=f"guess for {host}")
                        guessed += 1
                    if len(names) == 1:
                        token = guess
                    break
        if not token:
            hosts_failed.append(host)
            continue
        if ("greenhouse", token) not in {(b["ats"], b["tenant"]) for b in registry.boards()}:
            status = A.verify_board(client, {"ats": "greenhouse", "tenant": token})
            if status != 200:
                hosts_failed.append(f"{host} ({token} {status})")
                continue
            added += registry.add_board("greenhouse", token, verified_status=200, source=samples[0])
        hosts_added += registry.add_host(host, token, verified_status=200, source=samples[0])
    for line in failed + [f"host {h}" for h in hosts_failed]:
        log(f"  not added: {line}")
    s = client.stats
    summary = (f"ATS_REGISTRY: boards added={added} known={len(known)} failed={len(failed)} "
               f"hosts added={hosts_added} failed={len(hosts_failed)} boards_guessed={guessed} candidates_ignored={cands['ignored']} "
               f"requests={s['requests']} skipped={s['skipped']} out_of_budget={client.out_of_budget()}")
    log(summary)
    return dict(added=added, failed=failed, hosts_added=hosts_added, hosts_failed=hosts_failed)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("build")
    b.add_argument("--limit", type=int, default=None, help="verify at most N new boards and N hosts")
    b.add_argument("--budget", type=int, default=3600, help="stop requesting after this many seconds")
    sub.add_parser("show")
    a = ap.parse_args(argv)
    reg = AtsRegistry()
    if a.cmd == "show":
        by = {}
        for brd in reg.boards():
            by[brd["ats"]] = by.get(brd["ats"], 0) + 1
        print(f"boards={len(reg)} {json.dumps(by, sort_keys=True)} hosts={len(reg.hosts())} emitted={len(reg.emitted())}")
        return 0
    fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("ats-registry: another build is running")
        return 2
    try:
        urls, companies = seen_urls()
        build(reg, A.Client(budget_s=a.budget), urls, a.limit, companies=companies)
    finally:
        os.close(fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
