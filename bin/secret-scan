#!/usr/bin/env python3
"""Fail when a credential shape or a private identifier is in this tree.

Run by bin/check.sh on every gate. Patterns are deliberately narrow: a
placeholder like xoxb-... has no 10-character body and does not match.
"""
from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SKIP = {".git", "venv", ".venv", "data", "dist", "node_modules", "__pycache__", ".doctor-cache"}
OWNER_ID = "939277" + "067676172328"
PATTERNS = [
    ("slack token", re.compile(r"xox[bpar]-[A-Za-z0-9-]{10,}")),
    ("api key", re.compile(r"\bsk-[a-z]+-[A-Za-z0-9_-]{20,}")),
    ("discord token", re.compile(r"\b[MN][A-Za-z\d]{23}\.[\w-]{6}\.[\w-]{27}\b")),
    ("owner id", re.compile(OWNER_ID)),
    ("private host path", re.compile(r"/home/scraper")),
    ("private notes", re.compile(r"interview_zone")),
    ("private vpn helper", re.compile(r"/opt/vpn/scripts/vpn-ctl")),
]


def files() -> list[Path]:
    self_path = Path(__file__).resolve()
    return [path for path in ROOT.rglob("*") if path.is_file()
            and path.resolve() != self_path
            and not (set(path.relative_to(ROOT).parts) & SKIP)]


def main() -> int:
    hits = 0
    for path in files():
        try:
            text = path.read_text(errors="ignore")
        except OSError:
            continue
        for label, pattern in PATTERNS:
            for match in pattern.finditer(text):
                line = text.count("\n", 0, match.start()) + 1
                shown = match.group(0)[:8] + "…"
                print(f"SECRET_SCAN:FAIL {path.relative_to(ROOT)}:{line} {label} {shown}")
                hits += 1
    if hits:
        print(f"SECRET_SCAN:NOT_MET ({hits} hit(s))")
        return 1
    print("SECRET_SCAN:MET")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
